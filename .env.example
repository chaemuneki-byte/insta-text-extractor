# 이 파일을 .env 로 복사해서 사용하세요. 전부 선택 사항입니다.

# 넣으면 영상 분석(주제·화면 설명), 번역, 카드뉴스 글자 읽기를 Claude가 합니다. 비워두면 무료 모드.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# 음성 인식 모델: tiny / base / small / medium / large-v3 (클수록 정확, 느림)
# GPU에서 쓸 모델 (기본 large-v3) / GPU가 안 될 때 CPU에서 쓸 모델 (기본 small)
WHISPER_MODEL=large-v3
WHISPER_MODEL_CPU=small
# auto(GPU 먼저 시도) / cuda / cpu
WHISPER_DEVICE=auto

# 로그인이 필요한 게시물용: 쿠키를 가져올 브라우저 (firefox 권장). cookies.txt 파일이 있으면 그게 우선.
# COOKIES_FROM_BROWSER=firefox

# PORT=8000

# 영상 화면 속 글자(자막) 읽기. 0 으로 하면 끄고 음성만 추출 (더 빠름)
# SCREEN_OCR=1
